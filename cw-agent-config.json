{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/httpd/access_log",
            "log_group_name": "/my-web-app/apache/access_log",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}